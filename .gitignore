plan/
artifacts/
# notebooks/* rather than notebooks/: git cannot re-include a file inside an excluded
# directory, so the negation below would never fire against a directory pattern.
notebooks/*
# ...except the generated Kaggle runner: it is the only way to reproduce the full
# evaluation without a local GPU, so it is worth reviewing. Regenerate it with
# scripts/build_kaggle_eval_notebook.py rather than editing the JSON.
!notebooks/docureason_full_eval_kaggle.ipynb
.ipynb_checkpoints/


